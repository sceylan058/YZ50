import torch
import torch.nn.functional as F
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

words = open('names.txt', 'r').read().splitlines()
chars = sorted(list(set(''.join(words))))
stoi = {s: i+1 for i, s in enumerate(chars)}
stoi['.'] = 0
vocab_size = len(stoi)
block_size = 3

def build_dataset(words):
    X, Y = [], []
    for w in words:
        context = [0] * block_size
        for ch in w + '.':
            ix = stoi[ch]
            X.append(context)
            Y.append(ix)
            context = context[1:] + [ix]
    return torch.tensor(X), torch.tensor(Y)

import random
random.seed(42)
random.shuffle(words)
n1 = int(0.8*len(words))
Xtr, Ytr = build_dataset(words[:n1])

def init_params(n_embd, n_hidden, vocab_size, block_size, w1_scale, seed=2147483647):
    g = torch.Generator().manual_seed(seed)
    C  = torch.randn((vocab_size, n_embd), generator=g)
    W1 = torch.randn((n_embd * block_size, n_hidden), generator=g) * w1_scale
    b1 = torch.randn(n_hidden, generator=g) * 0.1
    W2 = torch.randn((n_hidden, vocab_size), generator=g) * 0.1
    b2 = torch.randn(vocab_size, generator=g) * 0.1
    params = [C, W1, b1, W2, b2]
    for p in params:
        p.requires_grad = True
    return params

n_embd = 10
healthy_scale = (5/3) / ((n_embd * block_size)**0.5)
bad_scale = 1.0

def saturation_vs_gradient(w1_scale, label=""):
    n_hidden_local = 200
    C, W1, b1, W2, b2 = init_params(n_embd, n_hidden_local, vocab_size, block_size, w1_scale)
    parameters = [C, W1, b1, W2, b2]

    ix = torch.randint(0, Xtr.shape[0], (32,), generator=torch.Generator().manual_seed(42))
    Xb, Yb = Xtr[ix], Ytr[ix]

    emb = C[Xb]
    embcat = emb.view(emb.shape[0], -1)
    hpreact = embcat @ W1 + b1
    h = torch.tanh(hpreact)
    logits = h @ W2 + b2
    loss = F.cross_entropy(logits, Yb)

    for p in parameters:
        p.grad = None
    loss.backward()

    neuron_saturation = h.abs().mean(0).detach()
    neuron_grad_factor = (1 - h**2).mean(0).detach()

    return neuron_saturation, neuron_grad_factor

sat_healthy_n, gradfac_healthy_n = saturation_vs_gradient(healthy_scale, "healthy")
sat_bad_n, gradfac_bad_n = saturation_vs_gradient(bad_scale, "bad")

fig, ax = plt.subplots(figsize=(8, 6))
ax.scatter(sat_healthy_n, gradfac_healthy_n, alpha=0.6, label="Sağlıklı başlatma", color='#3498db')
ax.scatter(sat_bad_n, gradfac_bad_n, alpha=0.6, label="Kötü başlatma", color='#e67e22')
ax.set_xlabel("Nöronun doyma seviyesi (|h| ortalaması)")
ax.set_ylabel("Gradyan geçirme kapasitesi (1 - h²)")
ax.set_title("Her nöron için: doydukça gradyan gerçekten sıfırlanıyor mu?")
ax.legend()
plt.tight_layout()
plt.savefig("neuron_saturation_vs_gradient.png", dpi=150)